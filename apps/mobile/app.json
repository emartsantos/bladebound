{
  "expo": {
    "name": "Ember & Iron",
    "slug": "ember-and-iron",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#131110",
    "primaryColor": "#d4692f",
    "scheme": "emberiron",
    "splash": {
      "backgroundColor": "#131110",
      "image": "./src/assets/splash.png",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.premiumrpg.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#131110",
        "foregroundImage": "./src/assets/adaptive-icon.png"
      },
      "package": "com.premiumrpg.mobile"
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}
